{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": {
    "python": "3.12",
    "postgresql": "17",
    "nodejs": "20",
    "git": "latest",
    "gcc": "latest",
    "gnumake": "latest",
    "pkg-config": "latest",
    "libxml2": "latest",
    "libxslt": "latest",
    "openssl": "latest",
    "zlib": "latest",
    "libjpeg": "latest",
    "libffi": "latest",
    "freetype": "latest",
    "lcms2": "latest",
    "openldap": "latest",
    "cyrus_sasl": "latest",
    "lessc": "latest",
    "rtlcss": "latest",
    "wkhtmltopdf": {
      "version": "latest",
      "excluded_platforms": ["aarch64-darwin"]
    }
  },
  "env": {},
  "shell": {
    "init_hook": [
      "export PYTHON_BIN=$(bash scripts/python-bin.sh)",
      "if [ -d .venv ] && [ ! -x .venv/bin/$PYTHON_BIN ]; then echo \"Recreating .venv (not on $PYTHON_BIN)...\"; rm -rf .venv; fi",
      "if [ ! -d .venv ]; then $PYTHON_BIN -m venv .venv; fi",
      ". .venv/bin/activate",
      "export PYTHONPATH=$PWD/odoo:$PYTHONPATH",
      "bash scripts/welcome.sh",
      "alias ls='ls --color=auto'"
    ],
    "scripts": {
      "setup": "bash devbox-setup.sh",
      "setup-once": "bash scripts/setup-task.sh once",
      "setup-force": "bash scripts/setup-task.sh force",
      "update-deps": ". .venv/bin/activate && sed 's/psycopg2==/psycopg2-binary==/' ./odoo/requirements.txt | pip install -r /dev/stdin && bash scripts/install-addons-deps.sh",
      "start-odoo": ". .venv/bin/activate && python ./odoo/odoo-bin -c odoo.conf --dev xml,qweb,werkzeug",
      "test-odoo": ". .venv/bin/activate && python ./odoo/odoo-bin -c odoo.conf -d test --test-enable --stop-after-init"
    }
  }
}
