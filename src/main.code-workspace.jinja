{
	"folders": [
		{
			// Named, so the settings below can refer to it whatever the
			// project directory is called.
			"name": "{{ project_name }}",
			"path": "."
		},
		{
			"path": "external-addons"
		}
	],
	"settings": {
		"devbox.autoShellOnTerminal": false,
		// Odoo Language Server (Odoo.odoo extension): one config for every
		// workspace folder. Files under external-addons open in that folder,
		// which has no odools.toml of its own, so without this they get none.
		// The profile is the one scripts/write-odools-toml.sh writes.
		"Odoo.serverConfigPath": "${workspaceFolder:{{ project_name }}}/odools.toml",
		"Odoo.selectedProfile": "{{ project_name }}",
		"search.useParentIgnoreFiles": false,
		"search.useIgnoreFiles": false,
		"search.exclude": {
			"external-addons": true,
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/node_modules": true,
			"**/.git": true,
			"**/.venv": true,
			"**/.devbox": true,
			"**/odoo-data": true,
			"**/*.egg-info": true,
			"**/.mypy_cache": true,
			"**/.pytest_cache": true,
			"**/.ruff_cache": true
		},
		"files.exclude": {
			"external-addons": true
		}
	},
	"extensions": {
		// mkhl.direnv: loads .envrc on folder open so VS Code (and its Python extension)
		// inherits the devbox env (PYTHON_BIN, PATH with python{{ python_version }}, etc.). Without it,
		// VS Code scans .venv outside devbox and pins to whatever interpreter is on disk.
		"recommendations": [
			"mkhl.direnv"
		],
		// Disable: causes `permission denied: /usr/bin` errors from auto-running
		// `.venv/bin/activate` in new terminals (conflicts with devbox shell).
		"unwantedRecommendations": [
			"ms-python.vscode-python-envs"
		]
	}
}
