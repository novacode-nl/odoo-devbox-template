{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "external-addons"
		}
	],
	"settings": {
		"devbox.autoShellOnTerminal": false,
		// No .venv activation typed into new terminals: it races the debug
		// launch command in the "Start Odoo" terminal ("/usr/b source ...").
		// launch.json sets the interpreter itself. Here, not only in
		// .vscode/settings.json: the Python Environments extension reads it
		// without a folder, so in this multi-root workspace only this level counts.
		"python.terminal.activateEnvironment": false,
		// Odoo Language Server (Odoo.odoo extension): the profile of the
		// odools.toml at the project root (scripts/write-odools-toml.sh).
		// No Odoo.serverConfigPath: the extension passes it to the server as
		// is, so ${workspaceFolder} is not expanded and only an absolute,
		// machine-specific path would work there.
		"Odoo.selectedProfile": "{{ project_name }}",
		"search.useParentIgnoreFiles": false,
		"search.useIgnoreFiles": false,
		"search.exclude": {
			"external-addons": true,
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/node_modules": true,
			"**/.git": true,
			"**/.venv": true,
			"**/.devbox": true,
			"**/odoo-data": true,
			"**/*.egg-info": true,
			"**/.mypy_cache": true,
			"**/.pytest_cache": true,
			"**/.ruff_cache": true
		},
		"files.exclude": {
			"external-addons": true
		}
	},
	"extensions": {
		// mkhl.direnv: loads .envrc on folder open so VS Code (and its Python extension)
		// inherits the devbox env (PYTHON_BIN, PATH with python{{ python_version }}, etc.). Without it,
		// VS Code scans .venv outside devbox and pins to whatever interpreter is on disk.
		"recommendations": [
			"mkhl.direnv"
		],
		// Disable: causes `permission denied: /usr/bin` errors from auto-running
		// `.venv/bin/activate` in new terminals (conflicts with devbox shell).
		"unwantedRecommendations": [
			"ms-python.vscode-python-envs"
		]
	}
}
